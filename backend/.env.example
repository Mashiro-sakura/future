APP_NAME=Future Analysis Push System
DATABASE_URL=sqlite:///./future_analysis.db
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WECHAT_WORK_WEBHOOK_URL=
WECHAT_MINIAPP_SUBSCRIBE_ENABLED=true
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
# Use the keyword IDs from the selected WeChat template. Values support {title}, {report_date}, {published_at}, {session}, {summary}, {recommendation}.
WECHAT_SUBSCRIBE_TEMPLATE_DATA={"thing1":"{title}","time2":"{published_at}","thing3":"{summary}"}
WECHAT_SUBSCRIBE_PAGE=pages/report/detail?id={report_id}
# Use developer while testing in WeChat DevTools, then switch to formal before release.
WECHAT_MINIAPP_STATE=developer
PUBLIC_CLIENT_URL=http://127.0.0.1:5174
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
USE_AKSHARE=true
SCHEDULER_ENABLED=true
BOOTSTRAP_SAMPLE_DATA=true
